# Copy to .env and fill in. Never commit .env.
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string,
# "Session pooler" URI). Used by the API; user requests run as `authenticated` under RLS.
DATABASE_URL=
# "jwks" if the project uses JWT signing keys (default for new projects), otherwise "secret".
SUPABASE_JWT_MODE=jwks
# Only for SUPABASE_JWT_MODE=secret: Project Settings -> API -> JWT secret.
SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Service role key (Project Settings -> API). Only for scripts/bootstrap.py demo-user; never ship it.
SUPABASE_KEY=
# Demo deployments (D-018): one account may approve its own cases and give both NDPS sign-offs.
DEMO_MODE=false
